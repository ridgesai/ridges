NETUID=62
SUBTENSOR_ADDRESS=wss://entrypoint-finney.opentensor.ai
SUBTENSOR_NETWORK=finney



MODE= # screener or validator

# MODE=screener only
SCREENER_NAME= # screener-X-X
SCREENER_PASSWORD=

# MODE=validator only
VALIDATOR_WALLET_NAME=
VALIDATOR_HOTKEY_NAME=



RIDGES_PLATFORM_URL=https://platform-v2.ridges.ai

# Optional - for screeners
# SCREENER_EDGE_KEY=



SEND_HEARTBEAT_INTERVAL_SECONDS=1
SET_WEIGHTS_INTERVAL_SECONDS=600
SET_WEIGHTS_TIMEOUT_SECONDS=90
REQUEST_EVALUATION_INTERVAL_SECONDS=10



SIMULATE_EVALUATION_RUNS=False
SIMULATE_EVALUATION_RUN_MAX_TIME_PER_STAGE_SECONDS=1
INCLUDE_SOLUTIONS=False
MAX_CONCURRENT_EVALUATION_RUNS=5



UPDATE_AUTOMATICALLY=True



# Local-storage cleanup (low-priority background prune of task cache + job artifacts)
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_ARTIFACT_RETENTION_HOURS=48
CLEANUP_TASK_CACHE_RETENTION_HOURS=168

# Docker janitor. Dry-run gates hourly and startup cleanup.
CLEANUP_DOCKER_ENABLED=true
CLEANUP_DOCKER_DRY_RUN=false
CLEANUP_STOPPED_GRACE_MINUTES=45
CLEANUP_RUNNING_TTL_HOURS=4
CLEANUP_IMAGE_TAG_GRACE_HOURS=6
CLEANUP_PULLED_IMAGE_DISK_PERCENT=50
CLEANUP_DISK_PRESSURE_PERCENT=75

# Bake delegates Compose builds to BuildKit
DOCKER_BUILDKIT=1
COMPOSE_BAKE=true
